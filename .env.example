# Supabase
# Find these in your Supabase project dashboard:
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Your Zernio API key is NOT set here. Sign up free at https://zernio.com
# and paste it into the app's Settings page after you register an account.

# AI Gateway (optional, for the AI Response flow node)
# Self-hosted: create a key at https://vercel.com/ai-gateway and set it below.
# Deployed on Vercel: leave this unset -- the AI Gateway authenticates
# automatically via OIDC, no key needed.
# AI_GATEWAY_API_KEY=your-gateway-key

# Cron secret -- authorizes requests to /api/cron/jobs, the scheduler that
# fires flow Delay-node timers. `npm run setup` generates and writes this
# for you automatically. To set it by hand instead:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
CRON_SECRET=your-cron-secret

# App (optional on Vercel -- its production URL is detected automatically)
# Set this only to force a custom-domain URL for webhooks/callbacks.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Deployment mode -- keep false for every self-hosted instance. Setting this
# to true enables MegaChat's separate hosted billing/activation gate and will
# send workspaces without a billing record to /locked.
HOSTED_MODE=false

# Signups -- no env var needed here. This instance is single-tenant by
# default: the first account registered becomes the owner, and further
# signups are blocked at the database. The toggle lives in the database,
# not here -- see "One instance, one owner" in SETUP.md to open/close it.

# Encryption (optional) -- when set, the Zernio API key and AI Gateway key
# stored on each workspace are encrypted at rest (AES-256-GCM) instead of
# being stored as plaintext. Leave unset for self-host and everything works
# exactly as today (plaintext). Recommended for hosted deployments.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Warning: if you change or lose this value after keys have been saved, those
# keys can no longer be decrypted -- affected workspaces will need to
# re-enter their API keys in Settings.
# ENCRYPTION_KEY=your-generated-key
